# ============================================================
# Шаблон переменных окружения для backend (скопируйте в .env)
# ============================================================

# --- База данных ---
# SQLite (по умолчанию) или Postgres: postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./app.db

# --- Безопасность (обязательно смените в production) ---
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS: через запятую или JSON-массив ---
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Окружение и логи ---
# ENVIRONMENT=development | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- API (rate limiting) ---
RATE_LIMIT_PER_MINUTE=60

# --- AI (опционально) ---
GROQ_API_KEY=
#DEEPSEEK_API_KEY=
